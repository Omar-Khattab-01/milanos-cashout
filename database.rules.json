{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },
    "devices": {
      "$uid": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },
    "employees": {
      ".read": "auth != null && (root.child('devices').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true)",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChild('name')",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "phone": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "active": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },
    "settings": {
      ".read": "auth != null && (root.child('devices').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true)",
      "rateCents": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.exists()",
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
      }
    },
    "companies": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChild('name')",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "$other": { ".validate": false }
      }
    },
    "expenses": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["date"],
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['id','companyId','companyName','date','amountCents','createdAt','createdBy'])",
        "id": { ".validate": "newData.val() === $id" },
        "companyId": { ".validate": "root.child('companies').child(newData.val()).exists()" },
        "companyName": { ".validate": "newData.isString() && newData.val() === root.child('companies').child(newData.parent().child('companyId').val()).child('name').val()" },
        "date": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
        "amountCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 10000000" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
        "createdBy": { ".validate": "newData.val() === auth.uid" },
        "$other": { ".validate": false }
      }
    },
    "cashoutReviews": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && root.child('cashouts').child($id).exists()",
        ".validate": "newData.hasChildren(['status','updatedAt','updatedBy'])",
        "status": { ".validate": "newData.val() === 'under_review' || newData.val() === 'reviewed'" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= now - 300000 && newData.val() <= now + 60000" },
        "updatedBy": { ".validate": "newData.val() === auth.uid" },
        "$other": { ".validate": false }
      }
    },
    "cashouts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["createdAt"],
      "$id": {
        ".write": "(data.exists() && !newData.exists() && auth != null && root.child('admins').child(auth.uid).val() === true) || (!data.exists() && newData.exists() && auth != null && (root.child('devices').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true) && newData.child('createdBy').val() === auth.uid && root.child('employees').child(newData.child('employeeId').val()).exists() && root.child('employees').child(newData.child('employeeId').val()).child('active').val() != false && newData.child('employeeName').val() === root.child('employees').child(newData.child('employeeId').val()).child('name').val() && newData.child('rateCents').val() === root.child('settings/rateCents').val() && !newData.child('corrections').exists() && newData.child('schemaVersion').val() === 3)",
        ".read": "auth != null && (root.child('devices').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true) && data.child('createdBy').val() === auth.uid",
        ".validate": "newData.hasChildren(['employeeId','employeeName','start','end','rateCents','id','createdBy','createdAt']) && newData.child('end').val() > newData.child('start').val() && newData.child('end').val() - newData.child('start').val() <= 86400000",
        "employeeId": { ".validate": "newData.isString()" },
        "employeeName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "start": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= now && newData.val() % 60000 === 0" },
        "end": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() % 60000 === 0" },
        "rateCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000" },
        "id": { ".validate": "newData.val() === $id" },
        "createdBy": { ".validate": "newData.isString()" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= now + 60000" },
        "schemaVersion": { ".validate": "newData.val() === 2 || newData.val() === 3" },
        "startingCashCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000" },
        "deliveries": { "$item": {
          ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000 && data.isNumber() && newData.val() === data.val()) || newData.hasChildren(['amountCents','billNumber']))",
          "amountCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000" },
          "billNumber": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)" },
          "$other": { ".validate": false }
        } },
        "tips": { "$item": {
          ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000 && data.isNumber() && newData.val() === data.val()) || newData.hasChildren(['amountCents','billNumber']))",
          "amountCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000" },
          "billNumber": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)" },
          "$other": { ".validate": false }
        } },
        "onlineTips": { "$item": {
          ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000 && data.isNumber() && newData.val() === data.val()) || newData.hasChildren(['amountCents','billNumber']))",
          "amountCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000" },
          "billNumber": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)" },
          "$other": { ".validate": false }
        } },
        "cashDeliveries": { "$item": {
          ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && newData.hasChildren(['billNumber','billTotalCents']) && ((!newData.child('cashCollectedCents').exists() && !newData.child('changeGivenCents').exists()) || (newData.hasChildren(['cashCollectedCents','changeGivenCents']) && newData.child('cashCollectedCents').val() - newData.child('changeGivenCents').val() >= newData.child('billTotalCents').val()))",
          "billNumber": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)" },
          "billTotalCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000" },
          "cashCollectedCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000" },
          "changeGivenCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000" },
          "$other": { ".validate": false }
        } },
        "corrections": {
          "$correction": {
            ".write": "!data.exists() && newData.exists() && auth != null && root.child('admins').child(auth.uid).val() === true",
            ".validate": "newData.hasChildren(['employeeId','employeeName','start','end','rateCents','reason','editedBy','editedAt']) && newData.child('end').val() > newData.child('start').val() && newData.child('end').val() - newData.child('start').val() <= 86400000 && newData.child('employeeId').val() === data.parent().parent().child('employeeId').val() && newData.child('rateCents').val() === data.parent().parent().child('rateCents').val()",
            "employeeId": { ".validate": "newData.isString()" },
            "employeeName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
            "start": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= now && newData.val() % 60000 === 0" },
            "end": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() % 60000 === 0" },
            "rateCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000" },
            "reason": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
            "editedBy": { ".validate": "newData.val() === auth.uid" },
            "editedAt": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= now - 300000 && newData.val() <= now + 60000" },
            "schemaVersion": { ".validate": "newData.val() === 2 || newData.val() === 3" },
            "startingCashCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000" },
            "deliveries": { "$item": {
              ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000) || newData.hasChildren(['amountCents','billNumber']))",
              "amountCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000" },
              "billNumber": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)" },
              "$other": { ".validate": false }
            } },
            "tips": { "$item": {
              ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000) || newData.hasChildren(['amountCents','billNumber']))",
              "amountCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000" },
              "billNumber": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)" },
              "$other": { ".validate": false }
            } },
            "onlineTips": { "$item": {
              ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000) || newData.hasChildren(['amountCents','billNumber']))",
              "amountCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000" },
              "billNumber": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)" },
              "$other": { ".validate": false }
            } },
            "cashDeliveries": { "$item": {
              ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && newData.hasChildren(['billNumber','billTotalCents']) && ((!newData.child('cashCollectedCents').exists() && !newData.child('changeGivenCents').exists()) || (newData.hasChildren(['cashCollectedCents','changeGivenCents']) && newData.child('cashCollectedCents').val() - newData.child('changeGivenCents').val() >= newData.child('billTotalCents').val()))",
              "billNumber": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)" },
              "billTotalCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000" },
              "cashCollectedCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000" },
              "changeGivenCents": { ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000" },
              "$other": { ".validate": false }
            } },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
