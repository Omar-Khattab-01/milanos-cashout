{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "devices": {
      "$uid": {
        ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },
    "employees": {
      ".read": "auth != null && (root.child('devices').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true)",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.exists()",
        ".validate": "newData.hasChildren(['name','active'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "settings": {
      ".read": "auth != null && (root.child('devices').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true)",
      "rateCents": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && newData.exists()",
        ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
      }
    },
    "cashouts": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["createdAt"],
      "$id": {
        "employeeId": {
          ".validate": "newData.isString() && root.child('employees').child(newData.val()).exists()"
        },
        "employeeName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
        },
        "start": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= now && newData.val() % 60000 === 0"
        },
        "end": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() % 60000 === 0"
        },
        "rateCents": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
        },
        "deliveries": {
          "$item": {
            ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000 && (data.isNumber() && newData.val() === data.val())) || newData.hasChildren(['amountCents','billNumber']))",
            "amountCents": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
            },
            "billNumber": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "tips": {
          "$item": {
            ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000 && (data.isNumber() && newData.val() === data.val())) || newData.hasChildren(['amountCents','billNumber']))",
            "amountCents": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
            },
            "billNumber": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "id": {
          ".validate": "newData.val() === $id"
        },
        "createdBy": {
          ".validate": "newData.isString()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= now + 60000"
        },
        ".write": "!data.exists() && newData.exists() && (auth != null && (root.child('devices').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true)) && newData.child('createdBy').val() === auth.uid && root.child('employees').child(newData.child('employeeId').val()).child('active').val() === true && newData.child('employeeName').val() === root.child('employees').child(newData.child('employeeId').val()).child('name').val() && newData.child('rateCents').val() === root.child('settings/rateCents').val() && !newData.child('corrections').exists() && newData.child('schemaVersion').val() === 2",
        ".read": "auth != null && (root.child('devices').child(auth.uid).val() === true || root.child('admins').child(auth.uid).val() === true) && data.child('createdBy').val() === auth.uid",
        "corrections": {
          "$correction": {
            "employeeId": {
              ".validate": "newData.isString() && root.child('employees').child(newData.val()).exists()"
            },
            "employeeName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80"
            },
            "start": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= now && newData.val() % 60000 === 0"
            },
            "end": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() % 60000 === 0"
            },
            "rateCents": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
            },
            "deliveries": {
              "$item": {
                ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000 && (data.isNumber() && newData.val() === data.val() || (root.child('cashouts').child($id).exists() && !root.child('cashouts').child($id).child('schemaVersion').exists()))) || newData.hasChildren(['amountCents','billNumber']))",
                "amountCents": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
                },
                "billNumber": {
                  ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "tips": {
              "$item": {
                ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000 && (data.isNumber() && newData.val() === data.val() || (root.child('cashouts').child($id).exists() && !root.child('cashouts').child($id).child('schemaVersion').exists()))) || newData.hasChildren(['amountCents','billNumber']))",
                "amountCents": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
                },
                "billNumber": {
                  ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "reason": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "editedBy": {
              ".validate": "newData.val() === auth.uid"
            },
            "editedAt": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= now - 300000 && newData.val() <= now + 60000"
            },
            ".write": "!data.exists() && newData.exists() && (auth != null && root.child('admins').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['employeeId','employeeName','start','end','rateCents']) && newData.child('end').val() > newData.child('start').val() && newData.child('end').val() - newData.child('start').val() <= 86400000 && newData.hasChildren(['reason','editedBy','editedAt']) && newData.child('employeeId').val() === data.parent().parent().child('employeeId').val() && newData.child('rateCents').val() === data.parent().parent().child('rateCents').val()",
            "$other": {
              ".validate": false
            },
            "schemaVersion": {
              ".validate": "newData.val() === 2"
            },
            "startingCashCents": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000"
            },
            "onlineTips": {
              "$item": {
                ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000 && (data.isNumber() && newData.val() === data.val() || (root.child('cashouts').child($id).exists() && !root.child('cashouts').child($id).child('schemaVersion').exists()))) || newData.hasChildren(['amountCents','billNumber']))",
                "amountCents": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
                },
                "billNumber": {
                  ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "cashDeliveries": {
              "$item": {
                ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && newData.hasChildren(['billNumber','billTotalCents','cashCollectedCents','changeGivenCents']) && newData.child('cashCollectedCents').val() - newData.child('changeGivenCents').val() >= newData.child('billTotalCents').val()",
                "billNumber": {
                  ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)"
                },
                "billTotalCents": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
                },
                "cashCollectedCents": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000"
                },
                "changeGivenCents": {
                  ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        ".validate": "newData.hasChildren(['employeeId','employeeName','start','end','rateCents']) && newData.child('end').val() > newData.child('start').val() && newData.child('end').val() - newData.child('start').val() <= 86400000 && newData.hasChildren(['id','createdBy','createdAt'])",
        "$other": {
          ".validate": false
        },
        "schemaVersion": {
          ".validate": "newData.val() === 2"
        },
        "startingCashCents": {
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000"
        },
        "onlineTips": {
          "$item": {
            ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && ((newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000 && (data.isNumber() && newData.val() === data.val())) || newData.hasChildren(['amountCents','billNumber']))",
            "amountCents": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
            },
            "billNumber": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "cashDeliveries": {
          "$item": {
            ".validate": "$item.matches(/^e[01][0-9][0-9]$/) && newData.hasChildren(['billNumber','billTotalCents','cashCollectedCents','changeGivenCents']) && newData.child('cashCollectedCents').val() - newData.child('changeGivenCents').val() >= newData.child('billTotalCents').val()",
            "billNumber": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9-]{1,40}$/)"
            },
            "billTotalCents": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 1 && newData.val() <= 100000"
            },
            "cashCollectedCents": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000"
            },
            "changeGivenCents": {
              ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 0 && newData.val() <= 100000"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
